PINECONE_API_KEY=your-pinecone-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key  # optional, only if using Claude for generation
LLM_PROVIDER=openai                       # "openai" or "anthropic"
LLM_MODEL=gpt-4o                          # model name override
LOOPIO_CLIENT_ID=                          # optional, for /ingest/loopio endpoint
LOOPIO_CLIENT_SECRET=                      # optional, for /ingest/loopio endpoint
PORT=8000
